{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run lint *)",
      "Bash(npm run format *)",
      "Bash(npm run build *)",
      "Bash(npm run test *)",
      "Bash(npm test *)",
      "Bash(npx tsc --noEmit *)",
      "Bash(npx prisma generate *)",
      "Bash(npx prisma validate *)",
      "Bash(npx prisma format *)",
      "Bash(npx prisma migrate dev *)",
      "Bash(npx prisma migrate status *)",
      "Bash(docker compose up -d db *)",
      "Bash(docker compose ps *)",
      "Bash(docker compose logs *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch *)",
      "Bash(git switch -c *)",
      "Bash(git checkout -b *)",
      "Bash(git add *)",
      "Bash(git commit *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(npm uninstall *)",
      "Bash(npx prisma migrate reset *)",
      "Bash(docker compose down *)",
      "Edit(/prisma/migrations/**)",
      "Edit(/.github/**)"
    ],
    "deny": [
      "Read(.env.staging)",
      "Read(.env.production)",
      "Read(.env.prod)",
      "Bash(npx prisma db push *)",
      "Bash(npx prisma migrate deploy *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard.mjs",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-file.mjs",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
