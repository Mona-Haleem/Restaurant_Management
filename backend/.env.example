# Local development defaults. Used as-is when there is no .env, so a fresh clone works.
# Copy to .env to change anything. Never commit .env. See docs/ENVIRONMENTS.md.
# Staging/production values live only in the password manager, Render and GitHub secrets.

# local | test | staging | production. The API and destructive Prisma commands check it.
APP_ENV=local

PORT=3000

# Host port of the Docker Postgres (docker-compose.yml). 5433 avoids a native Postgres on 5432.
DB_PORT=5433

# The running app's connection (staging/production: Supabase transaction pooler).
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/tablz_dev
# Migrations' connection (staging/production: Supabase session pooler, IPv4). Locally the same DB.
DIRECT_URL=postgresql://postgres:postgres@localhost:5433/tablz_dev

# Integration tests (npm run test:e2e) use this database, never the one above.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/tablz_test

# Comma-separated browser origins allowed by CORS. Required on staging/production.
# Defaults to the Angular dev server (http://localhost:4200) on local/test.
# One "*" is allowed inside the first host label, e.g. https://tablz-*-team.vercel.app.
# It matches letters/digits only (Vercel hash URLs); list hyphenated branch aliases exactly.
CORS_ORIGINS=http://localhost:4200

# fatal | error | warn | info | debug | trace | silent.
# Defaults: debug (local, pretty-printed), silent (test), info (staging/production, JSON).
# LOG_LEVEL=debug
