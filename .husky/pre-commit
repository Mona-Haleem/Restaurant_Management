#!/bin/sh
echo "🔍 Running pre-commit checks..."
npx lint-staged
echo "🧪 Running tests..."
npm test
if git diff --cached --name-only | grep -q '^backend/'; then
  echo "🧪 Running backend unit tests..."
  npm --prefix backend test
fi
echo "✅ Pre-commit checks passed!"

